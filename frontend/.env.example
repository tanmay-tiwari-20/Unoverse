# Base URL of the Unoverse backend (Express + Socket.IO server).
# Must be reachable from the browser. Defaults to http://localhost:3001 if unset.
# In production use your HTTPS backend URL, e.g. https://api.unoverse.example.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Voice relay configuration belongs on the backend (TURN_URLS + TURN_SHARED_SECRET).
# The browser fetches expiring credentials after explicit voice membership.
# Never put permanent relay credentials in NEXT_PUBLIC_* variables.
