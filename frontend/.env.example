# Base URL of the Unoverse backend (Express + Socket.IO server).
# Must be reachable from the browser. Defaults to http://localhost:3001 if unset.
# In production use your HTTPS backend URL, e.g. https://api.unoverse.example.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ---- Voice chat TURN server (optional but recommended for production) --------
# WebRTC voice needs a TURN relay to connect players behind symmetric NATs /
# strict firewalls (mobile data, corporate networks). Without TURN, voice works
# for many players but silently fails for others. Get credentials from a hosted
# TURN provider (Metered, Twilio, Cloudflare) or self-host coturn.
# Comma-separate NEXT_PUBLIC_TURN_URL for multiple transports.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-password
