# Port the HTTP + Socket.IO server listens on
PORT=3001

# How long (ms) a player has to act before the server auto-resolves their turn
# (auto-draw when playing, auto-pick color on a pending Wild). Default 45000.
TURN_TIMEOUT_MS=45000

# Log verbosity: debug | info | warn | error | silent.
# Defaults to "debug" in development and "info" in production.
LOG_LEVEL=

# Comma-separated list of allowed browser origins for CORS (shared by Express and
# Socket.IO). In DEVELOPMENT, localhost is always allowed and "*"/empty reflects any
# origin. In PRODUCTION (NODE_ENV=production) this MUST be an explicit allow-list —
# a missing, empty, or "*" value makes the server refuse to start.
# e.g. CORS_ORIGIN=https://unoverse.example.com,https://www.unoverse.example.com
CORS_ORIGIN=*

# Room persistence backend so in-progress games survive a server restart:
#   file   (default) - one JSON snapshot per room on local disk. Zero infra.
#   redis            - shared store; required for running multiple instances.
#   memory           - no persistence (original behaviour).
STORE=file

# Directory for the file store (only used when STORE=file). Defaults to ./.data/rooms
# DATA_DIR=./.data/rooms

# Redis connection string (required when STORE=redis).
# e.g. redis://localhost:6379 or rediss://user:pass@host:6380
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Player profiles & statistics. All optional.
# ---------------------------------------------------------------------------
# Persistent profiles reuse the same STORE selector (file/redis/memory) and, for
# redis, the same REDIS_URL as rooms — profiles live under key prefix uno:profile:.
# Directory for the file store (only used when STORE=file). Defaults to ./.data/profiles
# PROFILE_DIR=./.data/profiles
# Max recent completed matches kept per profile for the match-history UI.
# RECENT_MATCHES_MAX=20
# Minimum HUMAN participants for a round to count toward lifetime stats.
# Defaults to 1, which counts solo-vs-bots practice too. Set to 2 to only record
# games against other people. Bots never count toward the total either way.
# PROFILE_MIN_HUMANS=1

# ---------------------------------------------------------------------------
# Socket rate limiting (per-socket, per-event token bucket). All optional —
# sensible defaults apply when unset. capacity = burst size, refill = tokens/sec.
# ---------------------------------------------------------------------------
# RL_DEFAULT_CAPACITY=30
# RL_DEFAULT_REFILL_PER_SEC=15
# RL_CHAT_CAPACITY=6
# RL_CHAT_REFILL_PER_SEC=1.5
# RL_REACTION_CAPACITY=10
# RL_REACTION_REFILL_PER_SEC=3
# RL_SIGNAL_CAPACITY=120
# RL_SIGNAL_REFILL_PER_SEC=60
# Min gap (ms) between "slow down" notices sent to a throttled client.
# RL_NOTIFY_GAP_MS=2000

# Max serialized bytes for a single webrtc-signal payload. Larger payloads are
# rejected before relay (valid audio SDP/ICE is well under this).
# WEBRTC_MAX_SIGNAL_BYTES=16384

# ---------------------------------------------------------------------------
# Chat moderation. All optional.
# ---------------------------------------------------------------------------
# Max characters kept per message (longer is truncated, not rejected).
# CHAT_MAX_LENGTH=300
# Sliding window + repeat threshold for spam detection.
# CHAT_DEDUPE_WINDOW=5
# CHAT_REPEAT_LIMIT=3
# Extra blocked words (comma-separated) merged with the built-in list.
# CHAT_BLOCKED_WORDS=word1,word2
# Set to 1 to REPLACE the built-in blocklist with CHAT_BLOCKED_WORDS instead of merging.
# CHAT_BLOCKED_WORDS_REPLACE=0

# ---------------------------------------------------------------------------
# Idle-room garbage collection. All optional.
# ---------------------------------------------------------------------------
# How often the background sweeper runs (ms).
# ROOM_SWEEP_INTERVAL_MS=60000
# Age (ms) after which a member-less room is deleted.
# ROOM_EMPTY_TTL_MS=600000
# Age (ms) after which a member-less FINISHED room is deleted (usually shorter).
# ROOM_FINISHED_TTL_MS=300000

# Turn-timer retry delay (ms) if an auto-resolution fails — the timer re-arms
# instead of giving up, so a room is never left without a working turn timer.
# TURN_TIMER_RETRY_MS=5000
